    "@google/genai": "^1.34.0",
    "@netlify/blobs": "^11.0.1",
    "file-saver": "2.0.5",
    "jspdf": "^4.2.1",
    "jszip": "3.10.1",
    "lz-string": "^1.5.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
