  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check:edge": "deno check --allow-import --config netlify/edge-functions/deno.check.json netlify/edge-functions/gemini.ts",
